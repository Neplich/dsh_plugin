{
  "name": "@neplich/dsh-web-workpanel",
  "description": "dsh Web GUI plugin: a right-side work panel with a workspace file browser and an interactive terminal",
  "version": "0.1.0",
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.zh-CN.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-session"
      ]
    }
  },
  "scripts": {
    "bundle": "tsdown"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.2",
    "@silurus/ooxml": "0.79.1",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/xterm": "^5.5.0",
    "pdfjs-dist": "^6.2.108",
    "ws": "^8.18.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-agent": "^0.1.2-alpha.3",
    "@deepseek-ai/dsh-host-webserver": "^0.1.2-alpha.3",
    "@deepseek-ai/dsh-session": "^0.1.2-alpha.3",
    "@deepseek-ai/dsh-subprocess": "^0.1.2-alpha.3"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-agent": "^0.1.2-alpha.3",
    "@deepseek-ai/dsh-client-locale": "^0.1.2-alpha.3",
    "@deepseek-ai/dsh-client-store": "^0.1.2-alpha.3",
    "@deepseek-ai/dsh-client-ui-conversation": "^0.1.2-alpha.3",
    "@deepseek-ai/dsh-client-ui-layout": "^0.1.2-alpha.3",
    "@deepseek-ai/dsh-client-ui-primitives": "^0.1.2-alpha.3",
    "@deepseek-ai/dsh-client-ui-renderer": "^0.1.2-alpha.3",
    "@deepseek-ai/dsh-client-ui-session": "^0.1.2-alpha.3",
    "@deepseek-ai/dsh-client-ui-slots": "^0.1.2-alpha.3",
    "@deepseek-ai/dsh-host-webserver": "^0.1.2-alpha.3",
    "@deepseek-ai/dsh-session": "^0.1.2-alpha.3",
    "@deepseek-ai/dsh-subprocess": "^0.1.2-alpha.3",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/ws": "^8.5.10",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsdown": "^0.22.2"
  }
}
